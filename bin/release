#!/usr/bin/env bash
# Releases DisableKeyboard from this Mac: a Developer ID build with the hardened runtime, notarized and stapled, in a
# notarized DMG, then (after you confirm) the release commit, the tag and the GitHub release with the DMG and the
# changelog's notes. Nothing is pushed or published before the confirmation; a failure before it restores the changelog.
#
# usage: bin/release <version>      e.g. bin/release 0.2
#        RELEASE_YES=1 skips the confirmation
# once:  xcrun notarytool store-credentials disablekeyboard-notary --apple-id <you@example.com> --team-id <team ID>
#        (an app-specific password from account.apple.com); NOTARY_PROFILE names another profile
set -euo pipefail
cd "$(dirname "$0")/.."

version="${1:-}"
[[ "$version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || { echo "usage: bin/release <version>  (e.g. 0.2)" >&2; exit 2; }
profile="${NOTARY_PROFILE:-disablekeyboard-notary}"
name=DisableKeyboard
out=build/release
dmg="$out/$name-$version.dmg"

say() { printf '\n\e[1m%s\e[0m\n' "$1"; }
die() { echo "bin/release: $1" >&2; exit 1; }

say "Checks"
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "uncommitted changes: commit or stash them first"
[[ "$(git symbolic-ref --short HEAD)" == main ]] || die "not on main"
git fetch -q origin
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || die "main is not origin/main: pull or push first"
git rev-parse -q --verify "refs/tags/v$version" > /dev/null && die "v$version is tagged already"
grep -q '^## Unreleased' CHANGELOG.md || die "CHANGELOG.md has no '## Unreleased' section"
notes="$(awk '/^## Unreleased/ { f = 1; next } /^## / { exit } f' CHANGELOG.md | sed '/./,$!d')"
[[ -n "$notes" ]] || die "nothing under '## Unreleased' in CHANGELOG.md"
identity="$(security find-identity -v -p codesigning | sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -1)"
[[ -n "$identity" ]] || die "no Developer ID Application certificate in the keychain"
team="$(sed -n 's/.*(\([A-Z0-9]*\))$/\1/p' <<< "$identity")"
xcrun notarytool history --keychain-profile "$profile" > /dev/null 2>&1 \
  || die "no notarytool profile '$profile': xcrun notarytool store-credentials $profile --apple-id <Apple ID> --team-id $team"
echo "  version $version, signed by $identity, notarized with profile $profile"

# from here on, any exit before publishing (a failed step, die, Ctrl-C) puts CHANGELOG.md back
restore() { git checkout -q -- CHANGELOG.md; }
finished=0
on_exit() {
  if (( !finished )); then restore; echo "bin/release: stopped; CHANGELOG.md restored" >&2; fi
}
trap on_exit EXIT
trap 'exit 130' INT

sed -i '' "s/^## Unreleased$/## Unreleased\\
\\
## $version — $(date +%Y-%m-%d)/" CHANGELOG.md

say "Build"
rm -rf "$out"
mkdir -p "$out"
# +1: the build number counts the release commit made below
CONFIGURATION=release CODESIGN_IDENTITY="$identity" VERSION="$version" \
  BUILD_NUMBER=$(( $(git rev-list --count HEAD) + 1 )) bin/build
app="build/$name.app"
codesign --verify --strict --deep "$app"
if codesign -d --entitlements - --xml "$app" 2>/dev/null | grep -q get-task-allow; then
  die "the app has the get-task-allow entitlement, which notarization refuses"
fi

notarize() {
  echo "  notarizing $(basename "$1") (a few minutes)…"
  xcrun notarytool submit "$1" --keychain-profile "$profile" --wait --output-format plist > "$out/notary.plist" || true
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :status' "$out/notary.plist" 2>/dev/null)" != Accepted ]]; then
    id="$(/usr/libexec/PlistBuddy -c 'Print :id' "$out/notary.plist" 2>/dev/null || true)"
    [[ -n "$id" ]] && xcrun notarytool log "$id" --keychain-profile "$profile" >&2
    die "notarization of $(basename "$1") was not accepted"
  fi
}

say "Notarize the app"
# stapled, so a copy dragged out of the DMG opens offline too
ditto -c -k --keepParent "$app" "$out/app.zip"
notarize "$out/app.zip"
xcrun stapler staple -q "$app"

say "DMG"
stage="$out/dmg"
mkdir -p "$stage"
ditto "$app" "$stage/$name.app"
ln -s /Applications "$stage/Applications"
hdiutil create -quiet -volname "$name" -srcfolder "$stage" -fs APFS -format ULFO "$dmg"
codesign --sign "$identity" --timestamp "$dmg"
notarize "$dmg"
xcrun stapler staple -q "$dmg"
spctl --assess --type open --context context:primary-signature "$dmg"
spctl --assess --type execute "$app"
shasum -a 256 "$dmg" | tee "$dmg.sha256"
echo "  $dmg ($(du -h "$dmg" | cut -f1))"

say "Publish"
printf '  %s\n' "${notes//$'\n'/$'\n  '}"
if [[ -z "${RELEASE_YES:-}" ]]; then
  read -r -p $'\nCommit, tag and publish '"$name $version"$' to GitHub? [y/N] ' answer
  if [[ "$answer" != [yY] ]]; then
    restore
    finished=1
    echo "not published; CHANGELOG.md restored, the DMG stays in $out"
    exit 0
  fi
fi
finished=1
git add CHANGELOG.md
git commit -q -m "Release $version"
git tag -a "v$version" -m "$name $version"
git push -q origin main "v$version"
gh release create "v$version" "$dmg" --title "$name $version" --notes "$notes"
echo "released: v$version"
